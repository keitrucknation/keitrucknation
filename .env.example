# Copy this file to .env (for your computer) and fill in the values.
# On Vercel, add the same names under Project > Settings > Environment Variables.
# Never commit the real .env file.

# Your live domain, e.g. https://keitrucknation.com (used for SEO links and the sitemap)
NEXT_PUBLIC_SITE_URL=

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Analytics / ads (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_ADSENSE_ID=

# Payments (optional, later)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# AI providers (optional, only if a feature uses them)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
